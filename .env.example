# Copy to .env and adjust for your machine. .env is ignored by git.

# SQL Server (local development only)
MSSQL_SA_PASSWORD=Docket_Local_Dev_123!
MSSQL_PORT=1433

# API
ASPNETCORE_ENVIRONMENT=Development
# ConnectionStrings__Default=Server=localhost,1433;Database=Docket;User Id=sa;Password=Docket_Local_Dev_123!;TrustServerCertificate=True;Encrypt=True

# JWT (set a long random value locally; never commit a real secret)
# Jwt__SigningKey=
# Jwt__Issuer=Docket.Api
# Jwt__Audience=Docket.Web

# First-run admin. Set these once in the deployment environment, then remove them.
# Bootstrap__AdminEmail=
# Bootstrap__AdminPassword=
# Bootstrap__AdminDisplayName=Docket Admin
